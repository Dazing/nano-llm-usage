# Copy to .env next to compose.yaml (chmod 0600). Reference: docs/deployment.md.
DASHBOARD_BIND_ADDRESS=192.168.1.50
DASHBOARD_HOST_PORT=8080
JARVIS_APPDATA_DIR=/mnt/cache/appdata/jarvis-token-dashboard
JARVIS_UID=1000
JARVIS_GID=1000
RADIANCE_BASE_URL=http://192.168.1.228:8000

# Deployed hosts: the digest from the image workflow run summary.
# Unset locally to use the jarvis-dashboard:0.1.0 tag that `docker compose build` creates.
#JARVIS_IMAGE=ghcr.io/dazing/nano-llm-usage@sha256:<digest>

# Optional: all three or none (docs/deployment.md, Cost rates).
COST_RATE_INPUT_PER_MTOK=1
COST_RATE_CACHED_INPUT_PER_MTOK=0.30
COST_RATE_OUTPUT_PER_MTOK=5
