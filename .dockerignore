# Version control and local state
.git
.gitignore
.venv
.pytest_cache
.ruff_cache

# Build outputs (the image builds its own wheel from src/)
dist
build
*.egg-info

# Python caches: the image disables bytecode writes
__pycache__
**/__pycache__
*.pyc
*.pyo

# Not shipped: tests, developer docs, tooling
tests
docs
scripts/*
!scripts/container_healthcheck.py
Dockerfile
compose.yaml
Dockerfile.*

# Never ship a database, WAL sidecar, snapshot, or recovery directory
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3.lock
*.pre-migration-*
*.pre-restore-*
